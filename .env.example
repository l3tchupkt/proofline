# Environment Configuration
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://proofline:proofline@localhost:5432/proofline

# Session Security (generate at least 32 random bytes in production)
SESSION_SECRET=replace-with-at-least-32-character-random-secret
SESSION_COOKIE_SECURE=false

# PayPal Sandbox Integration (hackathon builds restrict to sandbox)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional Sandbox Buyer Testing Credentials (only used by scripts/create-sandbox-dispute.ts)
PAYPAL_SANDBOX_BUYER_PAYER_ID=

# Anthropic AI Investigation Engine
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Private Evidence Storage
STORAGE_DRIVER=local
STORAGE_PATH=./storage/evidence

# Optional S3-Compatible Storage (used when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Clearly labelled demo mode (never mixes with live PayPal sandbox records)
DEMO_MODE=true
DEMO_LOGIN_EMAIL=merchant@demo.proofline.local
DEMO_LOGIN_PASSWORD=ProoflineDemo!2026

