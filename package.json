{
  "name": "proofline",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence you can trace. Disputes you can defend.",
  "license": "Apache-2.0",
  "author": "Lakshmikanthan K (https://github.com/l3tchupkt)",
  "repository": {
    "type": "git",
    "url": "https://github.com/l3tchupkt/proofline.git"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @proofline/database db:generate",
    "db:migrate": "pnpm --filter @proofline/database db:migrate",
    "verify:env": "tsx scripts/verify-environment.ts",
    "sandbox:setup": "tsx scripts/setup-sandbox.ts",
    "sandbox:sync": "tsx scripts/sync-disputes.ts",
    "sandbox:create-dispute": "tsx scripts/create-sandbox-dispute.ts",
    "demo:seed": "tsx scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.2",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
